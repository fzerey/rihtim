{
  "name": "rihtim",
  "version": "0.1.0",
  "private": true,
  "description": "Rihtim - Open-source Docker Desktop alternative (web UI) with WSL support",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "desktop:dev": "pnpm --filter @rihtim/desktop electron:dev",
    "desktop:package": "node scripts/build-desktop.mjs",
    "test:e2e": "pnpm --filter @rihtim/e2e test",
    "test:e2e:web": "pnpm --filter @rihtim/e2e test:web",
    "test:e2e:desktop": "pnpm --filter @rihtim/e2e test:desktop"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.15"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
